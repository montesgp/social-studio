{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CHECKPOINT_NAME}}"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    }
  },
  "5": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": {
      "preset": "{{IPADAPTER_MODEL}}",
      "model": ["1", 0]
    }
  },
  "6": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["5", 0],
      "image": ["4", 0],
      "weight": 0.8
    }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": {{WIDTH}},
      "height": {{HEIGHT}},
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0],
      "seed": {{SEED}},
      "steps": {{STEPS}},
      "cfg": {{CFG}},
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "vae": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["vae", 0],
      "filename_prefix": "incoders-hive"
    }
  }
}
