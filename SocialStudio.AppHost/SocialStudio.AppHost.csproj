<Project Sdk="Aspire.AppHost.Sdk/13.1.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>45b43659-1809-43a3-a73e-21d6d4926df6</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(Configuration)' == 'Debug' and '$(LocalDevSignBinaries)' == ''">
    <LocalDevSignBinaries>true</LocalDevSignBinaries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialStudio.ApiService\SocialStudio.ApiService.csproj" />
  </ItemGroup>

  <Target Name="SignLocalDevBinaries" AfterTargets="Build" Condition="'$(LocalDevSignBinaries)' == 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\dev\Sign-LocalDevBinaries.ps1&quot; -OutputDir &quot;$(TargetDir)&quot;" />
  </Target>

</Project>
