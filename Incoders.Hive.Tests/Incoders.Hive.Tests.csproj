<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Incoders.Hive.Application\Incoders.Hive.Application.csproj" />
    <ProjectReference Include="..\Incoders.Hive.Domain\Incoders.Hive.Domain.csproj" />
    <ProjectReference Include="..\Incoders.Hive.Infrastructure\Incoders.Hive.Infrastructure.csproj" />
    <!-- WU-11b: no endpoint test existed anywhere in this suite before MapNicheDiscoveryEndpointsTests
         (task 11b.3) — the ApiService project was never a test dependency. Added so the endpoint
         facade can be exercised directly, mirroring how every other Endpoints facade is already
         written to be testable without a full host. -->
    <ProjectReference Include="..\Incoders.Hive.ApiService\Incoders.Hive.ApiService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Infrastructure\Social\Fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- CAVS WU-0: byte-identity golden for BuildFlatColorMarkup/BuildFlatCarouselSlots
         (client-aesthetic-visual-sophistication, design decision 6). -->
    <None Update="Application\Social\ContentGeneration\Pipeline\Goldens\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
