{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SUPABASE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Incoders.Hive",
      "Audience": "Incoders.Hive",
      "Secret": "__SET_IN_USER_SECRETS__",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 7
    }
  },
  "SeedUsers": {
    "SysAdmin": {
      "Email": "sysadmin@incoders.ai",
      "Password": "__SET_IN_USER_SECRETS__",
      "DisplayName": "Platform Sysadmin"
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "HeaderName": "X-Tenant-Id"
  },
  "Persistence": {
    "Provider": "Postgres",
    "ConnectionStringName": "Postgres"
  },
  "Cache": {
    "Provider": "InMemory"
  }
}
