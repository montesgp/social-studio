{
  "NicheDiscovery": {
    "YouTubeDataApi": {
      "BaseAddress": "https://www.googleapis.com/youtube/v3",
      "SamplingRegions": [ "AR", "ES", "ID", "DE" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "Enabled": true,
    "MinimumLevel": "Information",
    "CategoryPrefix": "Incoders.Hive",
    "Path": "../logs/hive-api.log"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "__SET_IN_USER_SECRETS__"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Incoders.Hive",
      "Audience": "Incoders.Hive",
      "Secret": "__SET_IN_USER_SECRETS__",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 7
    }
  },
  "SeedUsers": {
    "SysAdmin": {
      "Email": "sysadmin@incoders.ai",
      "Password": "__SET_IN_USER_SECRETS__",
      "DisplayName": "Platform Sysadmin"
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "HeaderName": "X-Tenant-Id"
  },
  "Persistence": {
    "Provider": "Postgres",
    "ConnectionStringName": "Postgres"
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Rendering": {
    "Engine": "Chromium",
    "MaxConcurrentRenders": 2,
    "PerRenderTimeoutSeconds": 15,
    "DeviceScaleFactor": 2
  },
  "ContentGeneration": {
    "AestheticGating": {
      "BlockOnFirstTime": true,
      "PollIntervalSeconds": 2,
      "MaxWaitSeconds": 600
    },
    "Worker": {
      "JobTimeoutMinutes": 60
    }
  },
  "ClientAssetStorage": {
    "RootPath": "storage/client-assets",
    "PublicBasePath": "/storage/client-assets",
    "MaxImageSizeBytes": 8388608,
    "AllowedImageContentTypes": [
      "image/jpeg",
      "image/jpg",
      "image/png",
      "image/webp",
      "image/gif"
    ]
  }
}
