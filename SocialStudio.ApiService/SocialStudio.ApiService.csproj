  <ItemGroup>
    <!-- Captured Apify discovery output replayed by DiscoverySeedImporter. Copied to the output
         directory so the importer resolves seed-data/discovery when the API runs from bin/ too. -->
    <!-- Update, not Include: the Web SDK already globs these in as Content, so Include would be a
         duplicate item (NETSDK1022). This only adds the copy behaviour. -->
    <Content Update="seed-data\discovery\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialStudio.Application\SocialStudio.Application.csproj" />
    <ProjectReference Include="..\SocialStudio.Infrastructure\SocialStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\SocialStudio.ServiceDefaults\SocialStudio.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WU-11b: lets MapNicheDiscoveryEndpointsTests call the internal endpoint facade directly,
         mirroring every other Endpoints facade's "testable without a host" design intent. -->
    <InternalsVisibleTo Include="SocialStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

  <Target Name="SignLocalDevBinaries" AfterTargets="Build" Condition="'$(LocalDevSignBinaries)' == 'true' and '$(OS)' == 'Windows_NT'">
    <!-- WU-11b GAP FIX: SocialStudio.Tests now references SocialStudio.ApiService
         (MapNicheDiscoveryEndpointsTests, task 11b.3), so a Debug build of the Tests project builds
         ApiService too, running this target for the first time from a non-interactive/non-profile
         shell context where the `Cert:` PSDrive is unavailable ("Cannot find drive" — a local
         Windows-PowerShell/session quirk, not an ApiService or test failure). Local dev code-signing
         is a machine-convenience step, not build correctness: ContinueOnError keeps the Debug build
         (and everything that depends on it) green when the signing environment isn't available,
         while still signing normally wherever it is. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\dev\Sign-LocalDevBinaries.ps1&quot; -OutputDir &quot;$(TargetDir)&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
